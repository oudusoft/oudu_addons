#: model_terms:ir.ui.view,arch_db:oudu_desktop.res_config_settings_view_form
msgid "Odoo, made native on your desktop."
msgstr "让 Odoo 真正融入你的桌面。"

#. module: oudu_desktop
#: model_terms:ir.ui.view,arch_db:oudu_desktop.res_config_settings_view_form
