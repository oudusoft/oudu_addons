#: model_terms:ir.ui.view,arch_db:oudu_desktop.res_config_settings_view_form
msgid "Whether the Oudu Desktop client takes over file uploads on this instance."
msgstr "Oudu Desktop 客户端是否接管此实例的文件上传。"

