<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.oudu_iot</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="oudu_base.res_config_settings_view_form"/>
        <field name="priority" eval="160"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='oudu_base']" position="inside">
                <h2>Oudu IoT</h2>
                <div class="row mt16 o_settings_container" name="oudu_iot">
                    <div class="col-12 o_setting_box" id="oudu_iot_setting">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <div class="row align-items-center">
                                <div class="col-12 col-lg-5">
                                    <a href="https://iot.oudu.top" target="_blank" rel="noopener">
                                        <img src="/oudu_iot/static/description/images/product_overview.png" alt="Oudu IoT product overview" class="img-fluid rounded border d-block" loading="lazy"/>
                                    </a>
                                </div>
                                <div class="col-12 col-lg-7">
                                    <div class="mb8 font-weight-bold">Native Odoo ESP32 edge hardware gateway</div>
                                    <p class="text-muted mb16">Connect scanners, scales, receipt printers and cameras to standard Odoo through the native IoT Box and ePOS interfaces. Devices work without this module; it adds a host list, connection tests and gateway shortcuts.</p>
                                    <div class="mb16">
                                        <a class="btn btn-primary" href="https://iot.oudu.top" target="_blank" rel="noopener" role="button">Get firmware</a>
                                        <a class="btn btn-secondary" href="https://iot.oudu.top/flash/" target="_blank" rel="noopener" role="button">Flash online</a>
                                        <button name="%(oudu_iot.action_oudu_iot_hosts)d" type="action" string="Manage hosts" class="btn btn-link"/>
                                    </div>
                                    <p class="text-muted small mb4">Online flashing needs desktop Chrome, Edge or Firefox. Connection tests need Chrome or Edge.</p>
                                    <p class="text-muted small mb0">Point of Sale: under Configuration › Settings › Connected Devices, enable IoT Box and enter an Oudu IoT host's address as its IP Address to use scanners, scales and receipt printing, or enable ePos Printer and enter it as the Epson Printer IP for receipts only. No Oudu module is required for this.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
