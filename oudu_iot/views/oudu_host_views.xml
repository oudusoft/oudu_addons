<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="oudu_host_view_list_iot" model="ir.ui.view">
        <field name="name">oudu.host.list.oudu_iot</field>
        <field name="model">oudu.host</field>
        <field name="arch" type="xml">
            <tree string="IoT Hosts" decoration-success="iot_last_test_status == 'ok'" decoration-warning="iot_last_test_status in ('duplicate', 'blocked', 'unsupported_browser')" decoration-danger="iot_last_test_status in ('device_error', 'not_oudu', 'unreachable')">
                <field name="name"/>
                <field name="address"/>
                <field name="version"/>
                <field name="iot_board"/>
                <field name="iot_last_test_status"/>
                <field name="last_test_at"/>
            </tree>
        </field>
    </record>

    <record id="oudu_host_view_form_iot" model="ir.ui.view">
        <field name="name">oudu.host.form.oudu_iot</field>
        <field name="model">oudu.host</field>
        <field name="arch" type="xml">
            <form string="IoT Host">
                <header>
                    <button name="action_iot_test" type="object" string="Test connection" class="btn-primary"/>
                    <button name="action_iot_gateway" type="object" string="Open gateway"/>
                    <button name="action_iot_refresh" type="object" class="d-none"/>
                </header>
                <sheet>
                    <div class="oudu_iot_host_texts">
                        <div class="d-none" data-oudu-iot-text="unsaved">Save this host before testing.</div>
                        <div class="d-none" data-oudu-iot-text="no_address">Enter the host address and save first.</div>
                        <div class="d-none" data-oudu-iot-text="rpc_error">Odoo did not answer. Reload the page and try again.</div>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Front counter"/></h1>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="address" placeholder="e.g. oudu-iot-1a2b3c4d.local"/>
                            <field name="note"/>
                        </group>
                        <group string="Last test">
                            <field name="iot_last_test_status"/>
                            <field name="iot_last_test_detail"/>
                            <field name="last_test_at"/>
                            <field name="last_test_ok" invisible="1"/>
                        </group>
                    </group>
                    <group name="iot_snapshot" string="Device snapshot">
                        <group>
                            <field name="uuid"/>
                            <field name="version"/>
                            <field name="iot_compat_identifier"/>
                        </group>
                        <group>
                            <field name="iot_chip"/>
                            <field name="iot_chip_rev"/>
                            <field name="iot_board"/>
                        </group>
                    </group>
                    <div class="alert alert-info mb-0" role="alert">Point of Sale: under Configuration › Settings › Connected Devices, enable IoT Box and enter this host's address as its IP Address to use scanners, scales and receipt printing, or enable ePos Printer and enter it as the Epson Printer IP for receipts only. No Oudu module is required for this.</div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_oudu_iot_hosts" model="ir.actions.act_window">
        <field name="name">IoT Hosts</field>
        <field name="res_model">oudu.host</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('product', '=', 'iot')]</field>
        <field name="context">{'default_product': 'iot'}</field>
    </record>

    <record id="action_oudu_iot_hosts_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="oudu_host_view_list_iot"/>
        <field name="act_window_id" ref="action_oudu_iot_hosts"/>
    </record>

    <record id="action_oudu_iot_hosts_view_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="oudu_host_view_form_iot"/>
        <field name="act_window_id" ref="action_oudu_iot_hosts"/>
    </record>

    <menuitem id="menu_oudu_iot" name="IoT" parent="oudu_base.menu_oudu_root" groups="base.group_system" sequence="60"/>
    <menuitem id="menu_oudu_iot_hosts" name="Hosts" parent="menu_oudu_iot" action="action_oudu_iot_hosts" sequence="10"/>
</odoo>
